# Copy this file to ".env" and fill in your own values. NEVER commit .env to GitHub.

# 1 = show OTP in the terminal when email fails (development). Set to 0 for the defense.
APP_DEBUG=1

# Optional. If empty, a random key is created once and stored in .secret_key
SECRET_KEY=

# Gmail that SENDS the OTP + the 16-character App Password (spaces are ignored)
MAIL_USERNAME=yourgmail@gmail.com
MAIL_PASSWORD=abcd efgh ijkl mnop

# Optional database overrides (XAMPP defaults are used when omitted)
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=barbertrack

# Idle session timeout in minutes (default 30)
# SESSION_MINUTES=30
